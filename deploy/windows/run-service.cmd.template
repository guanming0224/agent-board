@echo off
rem Generated by scripts/installer.mjs. Task Scheduler may not carry the user's PATH, so set it here.
rem UTF-8 so paths with non-ASCII characters survive; this file is written as UTF-8.
chcp 65001 >nul
{{ENV}}
cd /d "{{WORKDIR}}"
"{{NODE}}" "{{ENTRY}}" >> "{{LOG}}" 2>&1
exit /b %ERRORLEVEL%
